# --- LLM: centralized factory profiles (see src/crypto_trader/llm/config.py) ---
# Phase 2: each agent resolves its own profile - 'deepseek_canary' (strategist),
# 'deepseek_analyst' (comprehensive analyst), 'deepseek_market' (market data analyst) and
# 'deepseek_news' (news/sentiment researcher). All provider deepseek, model deepseek/deepseek-chat.
DEEPSEEK_API_KEY="your own key"

# Optional DeepSeek overrides. Profile-specific names (DEEPSEEK_CANARY_*, DEEPSEEK_ANALYST_*,
# DEEPSEEK_MARKET_*, DEEPSEEK_NEWS_*) take precedence over provider-wide names (DEEPSEEK_*),
# which take precedence over defaults.
# DEEPSEEK_MODEL="deepseek/deepseek-chat"
# DEEPSEEK_BASE_URL="https://api.deepseek.com"
# DEEPSEEK_TIMEOUT_SECONDS="60"
# DEEPSEEK_MAX_ATTEMPTS="3"
# DEEPSEEK_BACKOFF_BASE_SECONDS="1"
# DEEPSEEK_BACKOFF_MAX_SECONDS="8"
# DEEPSEEK_REQUESTS_PER_MINUTE="60"
# DEEPSEEK_MIN_INTERVAL_SECONDS="0"

# --- LLM: legacy per-agent model for agents not yet migrated ---
OPENAI_API_KEY="your own key"

# --- News / sentiment research (Serper) ---
SERPER_API_KEY="your own key"

# --- Binance market data (official public REST API; no credentials required) ---
# Optional. Defaults to https://api.binance.com when unset.
BINANCE_API_BASE_URL="https://api.binance.com"
# Optional. Request timeout in seconds (default 10).
BINANCE_HTTP_TIMEOUT="10"
# Optional. Total request attempts, including the first one (default 3).
BINANCE_HTTP_MAX_ATTEMPTS="3"

# --- Not used by the current code paths ---
OPENROUTER_API_KEY="your own key"
COINAPI_KEY="your own key"
